---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A public static teaching site comparing broken and fixed interfaces across roles.',
} = Astro.props;
const pathname = Astro.url.pathname;
const stationsCurrent = pathname === '/' || pathname.startsWith('/stations/');
---

<!doctype html>
<html lang="en" data-atk-mode="builder">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · A11y Test Kitchen</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20rx='12'%20fill='%231A212D'/%3E%3Ccircle%20cx='32'%20cy='32'%20r='20'%20fill='%23F0F6FA'/%3E%3Cpath%20d='M22%2020v24M18%2020v10c0%204%208%204%208%200V20M42%2020v24M42%2020c-6%203-6%2014%200%2017'%20fill='none'%20stroke='%2322557E'%20stroke-width='4'%20stroke-linecap='round'/%3E%3C/svg%3E" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="masthead">
      <div class="container masthead-inner">
        <a href="/" class="brand-link">
          <span>A11y Test Kitchen</span>
          <span class="brand-badge">Exhibit</span>
        </a>

        <nav aria-label="Main navigation">
          <ul class="nav-links">
            <li><a href="/" class="nav-link" aria-current={stationsCurrent ? 'page' : undefined}>Stations</a></li>
            <li>
              <a
                href="/about/"
                class="nav-link"
                aria-current={pathname === '/about/' ? 'page' : undefined}
              >About &amp; philosophy</a>
            </li>
          </ul>
        </nav>

        <div class="mode-switch">
          <span class="visually-hidden" id="atk-mode-label">Choose explanation audience:</span>
          <div class="mode-switch-group" role="group" aria-labelledby="atk-mode-label">
            <button
              type="button"
              class="mode-btn"
              data-mode="advocate"
              data-atk-mode-button="advocate"
              aria-pressed="false"
            >Advocate</button>
            <button
              type="button"
              class="mode-btn"
              data-mode="builder"
              data-atk-mode-button="builder"
              aria-pressed="true"
            >Builder</button>
            <button
              type="button"
              class="mode-btn"
              data-mode="presenter"
              data-atk-mode-button="presenter"
              aria-pressed="false"
            >Presenter</button>
          </div>
        </div>
      </div>
    </header>

    <main id="main-content" tabindex="-1" class="container page-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div class="footer-copy">
          <p><strong>A11y Test Kitchen</strong> · Judging the interface, never the person.</p>
          <p class="footer-note">
            A public static accessibility teaching exhibit. No analytics, tracking, or storage beyond the mode preference.
          </p>
        </div>
        <p class="footer-baseline">WCAG 2.2 reference baseline</p>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const modes = new Set(['advocate', 'builder', 'presenter']);
        const root = document.documentElement;
        if (root.dataset.atkModeBound === 'true') return;
        root.dataset.atkModeBound = 'true';

        const buttons = Array.from(document.querySelectorAll('[data-atk-mode-button]'));

        const savedMode = () => {
          try {
            const saved = window.localStorage.getItem('atk-mode');
            return modes.has(saved) ? saved : 'builder';
          } catch {
            return 'builder';
          }
        };

        const applyMode = (requestedMode, persist = false) => {
          const mode = modes.has(requestedMode) ? requestedMode : 'builder';
          root.dataset.atkMode = mode;

          buttons.forEach((button) => {
            button.setAttribute('aria-pressed', String(button.dataset.atkModeButton === mode));
          });

          document.querySelectorAll('[data-atk-mode-panel]').forEach((panel) => {
            panel.hidden = panel.dataset.atkModePanel !== mode;
          });

          if (persist) {
            try {
              window.localStorage.setItem('atk-mode', mode);
            } catch {
              // The in-page choice remains usable when storage is blocked.
            }
          }
        };

        buttons.forEach((button) => {
          button.addEventListener('click', () => applyMode(button.dataset.atkModeButton, true));
        });

        applyMode(savedMode());
      })();
    </script>
  </body>
</html>
