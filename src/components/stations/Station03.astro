---
import StationFrame from '../StationFrame.astro';
import StationPanel from '../StationPanel.astro';
import { stations } from '../../data/stations.js';

const station = stations.find((candidate) => candidate.id === '03');
if (!station) throw new Error('Station 03 metadata is missing.');

const advocate = {
  happened: 'The return policy hides a simple choice inside dense legal language and unfamiliar terms.',
  matters: 'People can miss a deadline, choose the wrong process, or give up even when the return is allowed. Extra reading also raises support costs.',
  hardest: 'People with cognitive or learning disabilities, limited English, fatigue, or little time may need more effort to extract the one action they need.',
  decision: 'Publish the plain action first, use short steps and familiar words, and keep the full legal policy available as supporting detail.',
};

const builder = {
  criterionNotes: {
    '3.1.5': 'At Level AAA, advanced text needs a simpler version or other help. The project’s sixth-grade target is an editorial choice, not the criterion’s exact threshold.',
  },
  moves: [
    'Put the person’s next action before policy detail.',
    'Use short sentences, concrete verbs, headings, and ordered steps.',
    'Keep required legal detail available without making it the only path to the task.',
  ],
  snippet: '<h3>Return this item</h3>\n<ol>\n  <li>Choose “Start online return.”</li>\n  <li>Print the free label.</li>\n  <li>Send the unopened item within 30 days.</li>\n</ol>',
  tests: [
    'Editorial: ask a reader to name the next action after one pass, without coaching.',
    'Keyboard and zoom: confirm headings, steps, and choices remain in a clear order at narrow widths.',
    'Policy review: compare the plain version with the source policy so no condition or deadline is lost.',
  ],
  boundary: 'A reading formula cannot prove that content is understandable. Human review with the intended audience remains necessary.',
};

const presenter = {
  steps: [
    { label: 'Set-up', time: '15s', text: 'Explain that both panels describe the same unopened blender returned after 12 days.' },
    { label: 'Barrier run', time: '45s', text: 'Read only the first dense paragraph, then try to choose the correct process without turning confusion into a joke.' },
    { label: 'Fixed run', time: '35s', text: 'Read the three short steps and choose Start online return.' },
    { label: 'Debrief', time: '25s', text: 'Point out that plain language preserved the policy while making the action visible.' },
  ],
  lines: [
    'People should not need a translator for an ordinary return.',
    'Put the next action before the policy detail.',
    'Clear words reduce mistakes without removing meaning.',
  ],
};
---

<StationFrame
  station={station}
  description="Compare dense return-policy language with short, actionable instructions."
  task={{
    goal: 'Start the correct return process for an unopened blender delivered 12 days ago.',
    use: 'Order ATK-302. The item is unopened and the return window is 30 days.',
    done: 'The panel confirms that your return has started.',
  }}
  {advocate}
  {builder}
  {presenter}
>
  <StationPanel slot="barrier" stationId={station.id} type="barrier" heading="Return policy as a reading wall">
    <div class="reading-wall" aria-labelledby="atk-03-barrier-policy-heading">
      <h3 id="atk-03-barrier-policy-heading">Merchandise disposition protocol</h3>
      <p>
        Pursuant to the applicable merchandise disposition protocol, a consumer seeking rescission
        of a completed transaction for non-defective culinary apparatus must initiate the digital
        merchandise-return authorization pathway no later than thirty calendar days subsequent to
        documented delivery, provided the commodity remains unopened, unutilized, and accompanied
        by its original constituent packaging.
      </p>
      <p>
        Manufacturer-warranty escalation is reserved for defective commodities, while final-sale
        exception processing applies only where the original transaction was expressly designated
        as non-returnable. Failure to select the procedurally appropriate remedy may delay review.
      </p>
    </div>
    <form class="station-form choice-form" data-atk-03-form data-correct="online">
      <fieldset>
        <legend>Choose the applicable disposition pathway</legend>
        <label><input type="radio" name="return-path" value="online" /> Initiate digital merchandise-return authorization</label>
        <label><input type="radio" name="return-path" value="warranty" /> Invoke manufacturer-warranty escalation</label>
        <label><input type="radio" name="return-path" value="exception" /> Apply final-sale exception processing</label>
      </fieldset>
      <p class="status-msg" data-atk-choice-status aria-live="polite"></p>
      <div class="form-actions">
        <button class="btn btn--barrier" type="submit">Continue</button>
        <button class="btn btn--secondary" type="button" data-atk-choice-reset>Reset Barrier</button>
      </div>
    </form>
  </StationPanel>

  <StationPanel slot="fixed" stationId={station.id} type="fix" heading="Return instructions in plain steps">
    <div class="plain-steps" aria-labelledby="atk-03-fixed-steps-heading">
      <h3 id="atk-03-fixed-steps-heading">Return this item</h3>
      <ol>
        <li>Choose <strong>Start online return</strong>.</li>
        <li>Print the free return label.</li>
        <li>Send the unopened blender within 30 days.</li>
      </ol>
      <details>
        <summary>Read the full policy details</summary>
        <p>Defective items use the maker’s warranty. Items marked final sale cannot be returned.</p>
      </details>
    </div>
    <form class="station-form choice-form" data-atk-03-form data-correct="online">
      <fieldset>
        <legend>What should you do?</legend>
        <label><input type="radio" name="return-path-fixed" value="online" /> Start online return</label>
        <label><input type="radio" name="return-path-fixed" value="warranty" /> Contact the maker about a defect</label>
        <label><input type="radio" name="return-path-fixed" value="exception" /> Stop because the item is final sale</label>
      </fieldset>
      <p class="status-msg" data-atk-choice-status aria-live="polite"></p>
      <div class="form-actions">
        <button class="btn btn--fix" type="submit">Continue</button>
        <button class="btn btn--secondary" type="button" data-atk-choice-reset>Reset Fixed</button>
      </div>
    </form>
  </StationPanel>
</StationFrame>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-atk-station="03"]');
    if (!root || root.dataset.atkDemoBound === 'true') return;
    root.dataset.atkDemoBound = 'true';

    root.querySelectorAll('[data-atk-03-form]').forEach((form) => {
      const panel = form.closest('[data-atk-panel]');
      const status = form.querySelector('[data-atk-choice-status]');
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const selected = form.querySelector('input[type="radio"]:checked');
        if (!selected) {
          if (status) status.textContent = 'Choose one option before you continue.';
          return;
        }
        if (status) {
          status.textContent = selected.value === form.dataset.correct
            ? 'Online return started for order ATK-302.'
            : 'That process does not match this order. Review the instructions and try again.';
        }
      });
      form.querySelector('[data-atk-choice-reset]')?.addEventListener('click', () => {
        form.reset();
        if (status) status.textContent = '';
        panel?.querySelector('.panel-heading')?.focus();
      });
    });
  })();
</script>
