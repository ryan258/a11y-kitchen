---
import StationFrame from '../StationFrame.astro';
import StationPanel from '../StationPanel.astro';

type Station = (typeof import('../../data/stations.js').stations)[number];

interface Props {
  station: Station;
}

const { station } = Astro.props;

const advocate = {
  happened: 'The transfer code appears once, then disappears before the form asks for it. The interface turns a provided value into a memory test.',
  matters: 'A person who forgets one digit must restart. That delay creates stress in a financial task and increases the chance of repeated attempts or abandonment.',
  hardest: 'People with memory, attention, language, or fatigue barriers—and anyone interrupted between screens—may lose information the system already had.',
  decision: 'Keep provided information available in the same process and offer a safe way to select or fill it instead of demanding recall.',
};

const builder = {
  criterionNotes: {
    '3.3.7': 'Auto-populate or offer a way to select information previously entered or supplied when the same process requires it again. Exceptions cover essential re-entry, security requirements, or information that is no longer valid.',
  },
  moves: [
    'Keep the provided code visible beside the confirmation field.',
    'Offer a Use this code control that fills the exact value without copying.',
    'Preserve the value and give a clear recovery path if validation fails.',
  ],
  snippet: "useCodeButton.addEventListener('click', () => {\n  confirmation.value = providedCode.textContent.trim();\n  confirmation.focus();\n});",
  tests: [
    'Keyboard: reach the code, use the fill control, submit, and reset without leaving the panel.',
    'Cognitive walkthrough: interrupt the task between code display and entry and confirm no recall is required in the fix.',
    'Security review: verify whether a real code is safe to display or reuse before applying this pattern.',
  ],
  boundary: 'The fictional transfer provides its own sample code. Check whether re-entry of a real verification code is essential for security before applying this pattern.',
};

const presenter = {
  steps: [
    { label: 'Set-up', time: '15s', text: 'Say that the same six-digit code confirms a fictional $25 transfer in both panels.' },
    { label: 'Barrier run', time: '40s', text: 'Read the code, continue, and show that it is gone when the form asks for it. Reset immediately if the participant wants the value back.' },
    { label: 'Fixed run', time: '35s', text: 'Keep the code in view, choose Use this code, and confirm the transfer.' },
    { label: 'Debrief', time: '25s', text: 'Explain that the system removed recall from a task without removing the confirmation step.' },
  ],
  lines: [
    'Do not turn provided information into a memory test.',
    'Keep it visible, selectable, or already filled.',
    'Reducing recall reduces errors for everyone.',
  ],
};
---

<StationFrame
  station={station}
  description="Compare a disappearing confirmation code with a visible, selectable code."
  task={{
    goal: 'Confirm a fictional $25 transfer to Jordan Kim.',
    use: 'A confirmation code, supplied inside each panel.',
    done: 'The panel confirms the transfer. No money moves.',
  }}
  {advocate}
  {builder}
  {presenter}
>
  <StationPanel slot="barrier" stationId={station.id} type="barrier" heading="A code shown once, then hidden">
    <div data-atk-06-barrier-code-step>
      <h3 id="atk-06-barrier-code-heading" tabindex="-1">Your confirmation code</h3>
      <p class="one-time-code" aria-labelledby="atk-06-barrier-code-heading">734219</p>
      <p>This code will not be shown on the next screen.</p>
      <div class="form-actions">
        <button class="btn btn--barrier" type="button" data-atk-06-barrier-continue>Continue</button>
      </div>
    </div>
    <form method="dialog" class="station-form" data-atk-06-barrier-form hidden novalidate>
      <h3 id="atk-06-barrier-entry-heading" tabindex="-1">Confirm the transfer</h3>
      <div class="form-group">
        <label for="atk-06-barrier-code">Enter the six-digit confirmation code</label>
        <input id="atk-06-barrier-code" name="code" inputmode="numeric" autocomplete="off" />
      </div>
      <p class="status-msg" data-atk-06-barrier-status aria-live="polite"></p>
      <div class="form-actions">
        <button class="btn btn--barrier" type="submit">Confirm transfer</button>
      </div>
    </form>
    <div class="form-actions">
      <button class="btn btn--secondary" type="button" data-atk-06-barrier-reset>Reset Barrier</button>
    </div>
  </StationPanel>

  <StationPanel slot="fixed" stationId={station.id} type="fix" heading="A code that stays available">
    <div class="code-and-entry">
      <div class="code-card">
        <h3 id="atk-06-fixed-code-heading">Confirmation code</h3>
        <p class="one-time-code" data-atk-06-fixed-provided-code>734219</p>
      </div>
      <form method="dialog" class="station-form" data-atk-06-fixed-form novalidate>
        <div class="form-group">
          <label for="atk-06-fixed-code">Confirmation code</label>
          <input
            id="atk-06-fixed-code"
            name="code"
            inputmode="numeric"
            autocomplete="off"
            aria-describedby="atk-06-fixed-code-hint atk-06-fixed-code-error"
          />
          <span id="atk-06-fixed-code-hint" class="field-hint">Enter or use the code shown beside this field.</span>
          <p id="atk-06-fixed-code-error" class="error-alert" role="alert" aria-atomic="true"></p>
        </div>
        <p class="status-msg" data-atk-06-fixed-status aria-live="polite"></p>
        <div class="form-actions">
          <button class="btn btn--secondary" type="button" data-atk-06-use-code>Use this code</button>
          <button class="btn btn--fix" type="submit">Confirm transfer</button>
          <button class="btn btn--secondary" type="button" data-atk-06-fixed-reset>Reset Fixed</button>
        </div>
      </form>
    </div>
  </StationPanel>

  <Fragment slot="station-script">
<script is:inline>
  (() => {
    const root = document.querySelector('[data-atk-station="06"]');
    if (!root || root.dataset.atkDemoBound === 'true') return;

    const barrierPanel = root.querySelector('[data-atk-panel="barrier"]');
    const codeStep = barrierPanel?.querySelector('[data-atk-06-barrier-code-step]');
    const barrierForm = barrierPanel?.querySelector('[data-atk-06-barrier-form]');
    const barrierInput = barrierPanel?.querySelector('#atk-06-barrier-code');
    const barrierStatus = barrierPanel?.querySelector('[data-atk-06-barrier-status]');
    barrierPanel?.querySelector('[data-atk-06-barrier-continue]')?.addEventListener('click', () => {
      if (codeStep) codeStep.hidden = true;
      if (barrierForm) barrierForm.hidden = false;
      barrierPanel.querySelector('#atk-06-barrier-entry-heading')?.focus();
    });
    barrierForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (barrierStatus) {
        barrierStatus.textContent = barrierInput?.value.trim() === '734219'
          ? 'Transfer confirmed. No money moved.'
          : 'Code does not match. Reset to view the supplied code again.';
      }
    });
    const resetBarrier = () => {
      barrierForm?.reset();
      if (barrierForm) barrierForm.hidden = true;
      if (codeStep) codeStep.hidden = false;
      if (barrierStatus) barrierStatus.textContent = '';
      barrierPanel.querySelector('.panel-heading')?.focus();
    };
    barrierPanel?.querySelectorAll('[data-atk-06-barrier-reset]').forEach((button) => {
      button.addEventListener('click', resetBarrier);
    });

    const fixedPanel = root.querySelector('[data-atk-panel="fixed"]');
    const fixedForm = fixedPanel?.querySelector('[data-atk-06-fixed-form]');
    const fixedInput = fixedPanel?.querySelector('#atk-06-fixed-code');
    const fixedProvidedCode = fixedPanel?.querySelector('[data-atk-06-fixed-provided-code]');
    const fixedError = fixedPanel?.querySelector('#atk-06-fixed-code-error');
    const fixedStatus = fixedPanel?.querySelector('[data-atk-06-fixed-status]');
    const getFixedCode = () => (fixedProvidedCode?.textContent || '').trim();
    const clearFixedValidation = () => {
      fixedInput?.removeAttribute('aria-invalid');
      if (fixedError) fixedError.textContent = '';
    };
    const clearFixedStatus = () => {
      if (fixedStatus) fixedStatus.textContent = '';
    };
    fixedPanel?.querySelector('[data-atk-06-use-code]')?.addEventListener('click', () => {
      if (fixedInput) fixedInput.value = getFixedCode();
      clearFixedValidation();
      clearFixedStatus();
      fixedInput?.focus();
    });
    fixedForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      clearFixedStatus();
      const fixedCode = getFixedCode();
      if (!fixedCode || fixedInput?.value.trim() !== fixedCode) {
        fixedInput?.setAttribute('aria-invalid', 'true');
        // Update the live alert while keeping focus in place.
        if (fixedError) {
          fixedError.textContent = 'Confirmation code: Enter the six digits shown beside this field.';
        }
        return;
      }
      clearFixedValidation();
      if (fixedStatus) fixedStatus.textContent = 'Transfer confirmed. No money moved.';
    });
    fixedInput?.addEventListener('input', () => {
      clearFixedValidation();
      clearFixedStatus();
    });
    fixedPanel?.querySelector('[data-atk-06-fixed-reset]')?.addEventListener('click', () => {
      fixedForm?.reset();
      clearFixedValidation();
      clearFixedStatus();
      fixedPanel.querySelector('.panel-heading')?.focus();
    });

    root.dataset.atkDemoBound = 'true';
  })();
</script>
  </Fragment>
</StationFrame>
