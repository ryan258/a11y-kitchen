---
import StationFrame from '../StationFrame.astro';
import StationPanel from '../StationPanel.astro';
import { stations } from '../../data/stations.js';

const station = stations.find((candidate) => candidate.id === '07');
if (!station) throw new Error('Station 07 metadata is missing.');

const advocate = {
  happened: 'The promo overlay cycles keyboard focus between promotional links and offers no visible close control. This safe lesson preserves Escape, even though a harmful production trap might not.',
  matters: 'When people cannot leave an overlay, every task behind it becomes unavailable. Confusing release instructions also make the site feel unsafe and out of control.',
  hardest: 'Keyboard-only and switch-device users can be stranded. Screen-reader users may hear the same controls repeat without a clear way back to the page.',
  decision: 'Require every overlay to provide a clearly named close control, a standard Escape action, tested focus behavior, and focus return to the opener.',
};

const builder = {
  criterionNotes: {
    '2.1.2': 'When keyboard focus can move into a component, the visitor must be able to move it away using standard keys or clearly explained methods. This bounded lesson keeps Escape as a safety release.',
  },
  moves: [
    'Use a native dialog or a fully tested dialog pattern with a visible close button.',
    'Support Escape without overriding browser Back or other platform behavior.',
    'Return focus to the control that opened the overlay after it closes.',
  ],
  snippet: "dialog.showModal();\ndialog.addEventListener('close', () => opener.focus());\n// A visible button calls dialog.close();\n// Native Escape remains available.",
  tests: [
    'Keyboard: open, traverse, close with the button, reopen, close with Escape, and confirm focus return.',
    'Safety: attempt Shift+Tab, repeated Tab, Escape, and browser Back from every overlay control.',
    'Assistive technology: confirm the dialog name, description, close control, and return point are announced.',
  ],
  boundary: 'The barrier is intentionally an escapable approximation, not a literal keyboard trap. Non-interference is more important than reproducing the full harm.',
};

const presenter = {
  steps: [
    { label: 'Set-up', time: '20s', text: 'State that the site will not create a real trap. Escape is the permanent safety release in the barrier.' },
    { label: 'Barrier run', time: '35s', text: 'Open the promo, Tab through the repeating links, then press Escape. Do not ask a participant to keep cycling.' },
    { label: 'Fixed run', time: '40s', text: 'Open the native dialog, use the visible Close promotion button, reopen, and use Escape. Show focus returning to Open promo.' },
    { label: 'Debrief', time: '25s', text: 'Explain that a real trap removes the safe exit this exhibit deliberately preserves.' },
  ],
  lines: [
    'If focus can enter, focus must be able to leave.',
    'Escape and a visible close control are both worth testing.',
    'A lesson about traps must not become a trap.',
  ],
};
---

<StationFrame
  station={station}
  description="Inspect an escapable focus cycle, then use a production-quality dialog with clear exits."
  task={{
    goal: 'Open and close the fictional promotion using only the keyboard.',
    use: 'In the barrier, Escape is the permanent host-owned safety release.',
    done: 'The overlay closes and focus returns to its opener.',
  }}
  {advocate}
  {builder}
  {presenter}
>
  <StationPanel slot="barrier" stationId={station.id} type="barrier" heading="A bounded focus cycle with safety Escape">
    <button class="btn btn--barrier" type="button" data-atk-07-barrier-open>Open promo</button>
    <div
      class="promo-overlay"
      role="dialog"
      aria-labelledby="atk-07-barrier-dialog-heading"
      aria-describedby="atk-07-barrier-dialog-safety"
      data-atk-07-barrier-dialog
      hidden
    >
      <h3 id="atk-07-barrier-dialog-heading">Weekend offer</h3>
      <p>Save on a fictional plan. The broken product offers no visible close control.</p>
      <p id="atk-07-barrier-dialog-safety" class="safety-note"><strong>Safety release:</strong> Press Escape at any time.</p>
      <div class="form-actions">
        <button class="btn btn--secondary" type="button" data-atk-07-cycle>View offer</button>
        <button class="btn btn--secondary" type="button" data-atk-07-cycle>Read terms</button>
      </div>
    </div>
    <p class="status-msg" data-atk-07-barrier-status aria-live="polite"></p>
    <div class="form-actions">
      <button class="btn btn--secondary" type="button" data-atk-07-barrier-reset>Reset Barrier</button>
    </div>
  </StationPanel>

  <StationPanel slot="fixed" stationId={station.id} type="fix" heading="A dialog with clear, standard exits">
    <button class="btn btn--fix" type="button" data-atk-07-fixed-open>Open promo</button>
    <dialog class="promo-dialog" aria-labelledby="atk-07-fixed-dialog-heading" data-atk-07-fixed-dialog>
      <h3 id="atk-07-fixed-dialog-heading">Weekend offer</h3>
      <p>Save on a fictional plan. You can close this message and continue.</p>
      <div class="form-actions">
        <button class="btn btn--fix" type="button" data-atk-07-fixed-close>Close promotion</button>
        <button class="btn btn--secondary" type="button">Read terms</button>
      </div>
    </dialog>
    <p class="status-msg" data-atk-07-fixed-status aria-live="polite"></p>
    <div class="form-actions">
      <button class="btn btn--secondary" type="button" data-atk-07-fixed-reset>Reset Fixed</button>
    </div>
  </StationPanel>
</StationFrame>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-atk-station="07"]');
    if (!root || root.dataset.atkDemoBound === 'true') return;
    root.dataset.atkDemoBound = 'true';

    const barrierPanel = root.querySelector('[data-atk-panel="barrier"]');
    const barrierOpen = barrierPanel?.querySelector('[data-atk-07-barrier-open]');
    const barrierDialog = barrierPanel?.querySelector('[data-atk-07-barrier-dialog]');
    const barrierStatus = barrierPanel?.querySelector('[data-atk-07-barrier-status]');
    const cycleControls = Array.from(barrierDialog?.querySelectorAll('[data-atk-07-cycle]') || []);
    const closeBarrier = (announce = true, restoreFocus = true) => {
      if (barrierDialog) barrierDialog.hidden = true;
      if (announce && barrierStatus) barrierStatus.textContent = 'Promotion closed with the safety Escape key.';
      if (restoreFocus) barrierOpen?.focus();
    };
    barrierOpen?.addEventListener('click', () => {
      if (barrierDialog) barrierDialog.hidden = false;
      if (barrierStatus) barrierStatus.textContent = '';
      cycleControls[0]?.focus();
    });
    barrierDialog?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeBarrier();
        return;
      }
      if (event.key !== 'Tab' || cycleControls.length === 0) return;
      event.preventDefault();
      const current = cycleControls.indexOf(document.activeElement);
      const delta = event.shiftKey ? -1 : 1;
      const next = (current + delta + cycleControls.length) % cycleControls.length;
      cycleControls[next].focus();
    });
    barrierPanel?.querySelector('[data-atk-07-barrier-reset]')?.addEventListener('click', () => {
      closeBarrier(false);
      if (barrierStatus) barrierStatus.textContent = '';
      barrierPanel.querySelector('.panel-heading')?.focus();
    });
    barrierPanel?.addEventListener('atk:panel-visibility', (event) => {
      if (!event.detail.visible && barrierDialog && !barrierDialog.hidden) closeBarrier(false, false);
    });

    const fixedPanel = root.querySelector('[data-atk-panel="fixed"]');
    const fixedOpen = fixedPanel?.querySelector('[data-atk-07-fixed-open]');
    const fixedDialog = fixedPanel?.querySelector('[data-atk-07-fixed-dialog]');
    const fixedStatus = fixedPanel?.querySelector('[data-atk-07-fixed-status]');
    const closeFixed = (announce = true, restoreFocus = true) => {
      if (fixedDialog?.open) fixedDialog.close();
      if (announce && fixedStatus) fixedStatus.textContent = 'Promotion closed. Focus returned to Open promo.';
      if (restoreFocus) fixedOpen?.focus();
    };
    fixedOpen?.addEventListener('click', () => {
      if (fixedStatus) fixedStatus.textContent = '';
      fixedDialog?.showModal();
    });
    fixedPanel?.querySelector('[data-atk-07-fixed-close]')?.addEventListener('click', () => closeFixed());
    fixedDialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeFixed();
    });
    fixedPanel?.querySelector('[data-atk-07-fixed-reset]')?.addEventListener('click', () => {
      closeFixed(false);
      if (fixedStatus) fixedStatus.textContent = '';
      fixedPanel.querySelector('.panel-heading')?.focus();
    });
    fixedPanel?.addEventListener('atk:panel-visibility', (event) => {
      if (!event.detail.visible && fixedDialog?.open) closeFixed(false, false);
    });
  })();
</script>
